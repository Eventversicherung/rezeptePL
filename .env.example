NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production must be the canonical host (apex redirects to www):
# NEXT_PUBLIC_SITE_URL=https://www.alemniam.de

# Optional IndexNow key override. Default matches public/{key}.txt
# INDEXNOW_KEY=

# Supabase AleMniam (publishable key preferred; anon key as fallback)
# Project: AleMniam · https://kdrbtwwhmzszzukcffsu.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public content source: seed (TypeScript files) or supabase (published rows)
CONTENT_SOURCE=supabase
